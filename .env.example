# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Required. Server-side only; this must never be exposed to the browser.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Force one model for every request instead of per-intent routing.
# "openrouter/free" costs nothing (free models, rate-limited, quality varies).
# Leave unset to use the cheap paid models in lib/routing.ts (~$0.002/rewrite).
# OPENROUTER_MODEL=openrouter/free

# Optional. Your public site URL, sent to OpenRouter for attribution.
# Defaults to http://localhost:3000 when unset.
SITE_URL=https://your-domain.com

# --- Not wired up yet. See docs/2026-07-14-supabase-integration-plan.md ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
